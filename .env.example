# Public Supabase project URL. Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anon key. Safe for browser use with Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only Supabase service role key. Never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Transcript reconciliation timeout recorded by the lifecycle pipeline in later waves.
TRANSCRIPT_RECONCILIATION_TIMEOUT_MS=5000

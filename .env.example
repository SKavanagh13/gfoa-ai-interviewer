# Public Supabase project URL. Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anon key. Safe for browser use with Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only Supabase service role key. Never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Server-only OpenAI key. Never expose to browser code.
OPENAI_API_KEY=replace-with-openai-api-key

# Realtime live interview configuration.
OPENAI_REALTIME_MODEL=gpt-realtime

# Server-only post-interview analysis model. Keep this separate from Realtime.
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
REALTIME_SESSION_TARGET_SECONDS=900
REALTIME_SESSION_HARD_CAP_SECONDS=1200
SIDEBAND_CONNECTION_TIMEOUT_MS=10000
SIDEBAND_DISPATCH_SECRET=replace-with-random-sideband-dispatch-secret

# Participant session cookies are HttpOnly; only this server secret signs the stored digest.
PARTICIPANT_SESSION_TOKEN_SECRET=replace-with-random-32-byte-secret
PARTICIPANT_SESSION_TOKEN_TTL_SECONDS=2700

# Long-lived Node sideband worker. Next.js routes dispatch here; they do not hold the WebSocket.
SIDEBAND_WORKER_BASE_URL=http://localhost:8787

# Transcript reconciliation timeout recorded by the lifecycle pipeline.
TRANSCRIPT_RECONCILIATION_TIMEOUT_MS=5000
